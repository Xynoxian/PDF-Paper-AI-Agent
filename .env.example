# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=pdf_rag

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# LLM (GraphRAG D3)
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.0-flash
LLM_TEMPERATURE=0.0

# Optional local Ollama — NO API key needed. Auto-detected; skip if not installed.
# If both cloud + Ollama fail, the app still answers using offline retrieval (always works).
# Install: https://ollama.com  then run: ollama pull llama3.2
FALLBACK_LLM_ENABLED=true
FALLBACK_LLM_BASE_URL=http://localhost:11434/v1
FALLBACK_LLM_MODEL=llama3.2

# River online learning
ADWIN_DELTA=0.002
RIVER_LR=0.01
RIVER_L2=1e-4
